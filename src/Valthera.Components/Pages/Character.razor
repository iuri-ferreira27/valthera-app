@page "/personagem"
@inject ValtheraApiClient Api

<h1>Personagem</h1>

<form class="v-toolbar" @onsubmit="SearchAsync">
    <label>
        Nome do personagem
        <input type="text" maxlength="64" placeholder="Ex.: Aldric Stormborn" @bind="_name" @bind:event="oninput" />
    </label>
    <button type="submit" class="v-btn" disabled="@(_loading || string.IsNullOrWhiteSpace(_name))">Buscar</button>
</form>

@if (_loading)
{
    <LoadingState Message="Buscando personagem..." />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" OnRetry="SearchAsync" />
}
else if (_notFound)
{
    <p class="v-muted">Personagem não encontrado. Confira o nome e tente de novo.</p>
}
else if (_profile is not null)
{
    <section class="v-card">
        <header>
            <h2>@_profile.Name</h2>
            <span class="v-pill @(_profile.Online ? "is-online" : "is-offline")">@(_profile.Online ? "Online" : "Offline")</span>
        </header>
        <dl class="v-stats">
            <div>
                <dt>Vocação</dt>
                <dd><VocationBadge Name="@_profile.Vocation" /></dd>
            </div>
            <div>
                <dt>Nível</dt>
                <dd>@Formatting.Number(_profile.Level)</dd>
            </div>
            <div>
                <dt>Nível mágico</dt>
                <dd>@Formatting.Number(_profile.MagicLevel)</dd>
            </div>
            <div>
                <dt>Último login</dt>
                <dd>@(_profile.LastLogin is { } login ? Formatting.DateTime(login) : "—")</dd>
            </div>
        </dl>
    </section>

    <h2>Mortes recentes</h2>
    @if (_profile.RecentDeaths.Count == 0)
    {
        <p class="v-muted">Nenhuma morte registrada.</p>
    }
    else
    {
        <div class="v-table-wrap">
            <table class="v-table">
                <thead>
                    <tr>
                        <th>Quando</th>
                        <th class="num">Nível</th>
                        <th>Morto por</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var death in _profile.RecentDeaths)
                    {
                        <tr>
                            <td>@Formatting.DateTime(death.Time)</td>
                            <td class="num">@Formatting.Number(death.Level)</td>
                            <td>
                                @death.KilledBy
                                @if (death.ByPlayer)
                                {
                                    <span class="v-badge v-badge-danger">jogador</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string _name = string.Empty;
    private string? _lastQueryName;
    private PlayerProfile? _profile;
    private bool _loading;
    private bool _notFound;
    private string? _error;

    /// <summary>Name passed in the link (<c>personagem?nome=...</c>) from other pages.</summary>
    [SupplyParameterFromQuery(Name = "nome")]
    public string? NameFromQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(NameFromQuery) && NameFromQuery != _lastQueryName)
        {
            _lastQueryName = NameFromQuery;
            _name = NameFromQuery;
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var name = _name.Trim();
        if (name.Length == 0)
        {
            return;
        }

        _loading = true;
        _error = null;
        _notFound = false;
        _profile = null;

        var result = await Api.GetPlayerAsync(name);
        _loading = false;
        if (result.IsSuccess)
        {
            _profile = result.Value;
        }
        else if (result.IsNotFound)
        {
            _notFound = true;
        }
        else
        {
            _error = result.Message;
        }
    }
}
